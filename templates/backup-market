              <div class="song-container">

                {% for Nft in Nft_Properties %}
                <div class="song">
                  <div class="song-img">
                    <img
                      src="{{url_for('static' , filename='Sources/assets/img/Avatars/view-futuristic-music-robot-droid_23-2151072897.avif')}}"
                      alt="" />
                    <div class="overlay">
                      <i class="fa-solid fa-play"></i>
                    </div>
                  </div>
                  <div class="song-title">
                    <h2>{{ Nft[1]}} </h2>
                    <p> **** **** **** {{ Nft[3][-4:]}} </p>
                  </div>
                  <button class="btn--primary"> > </button> 
                </div>
