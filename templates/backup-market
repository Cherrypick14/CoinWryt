                  <i class="fab fa-ethereum"></i> {{Traction[-6]}} ETH
                </div>
                <br>
                <div class="nft-unlock">
                  <input type="button" class="btn btn--primary" value="Unlock">
                </div>
              </div>
            </div>
            {% else %}
            <!-- Intended For Freemium Nfts-->
            <div class="nft-card nft-card--compact">
              <div class="nft-card--header">
                <div class="nft-user">
                  <img src="/static/Sources/assets/img/Avatars/androgynous-avatar-non-binary-queer-person_23-2151100228.avif">
                  {{Traction[0]}}
                  <span> {{ Traction[3][10:]}} </span>
                </div>
              </div>
              <div class="nft-card--content">
                <div class="nft-action">
                  <span> {{Traction[8]}} <i class="far fa-heart"></i></span>
                </div>
                <img src="/static/Sources/assets/img/Avatars/androgynous-avatar-non-binary-queer-person_23-2151100228.avif">
                <div class="nft-qrcode">
                  <span class="badge"> View </span>
                </div>
              </div>
              <div class="nft-card--footer">
                <div class="nft-price">
